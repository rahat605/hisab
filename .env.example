# Copy this file to .env in the project root, then replace both values.
# Supabase Dashboard > Project Settings > API
# Use the Project URL and the publishable key (or legacy anon public key).
# NEVER use a service_role key or any secret key in Vite/browser code.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
