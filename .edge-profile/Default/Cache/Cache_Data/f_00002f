   -------------------------------------------------------------------------- */
.theme-mode-toggle {
  width: 40px;
  height: 40px;
  min-width: 40px;
  border: 1px solid #dce7df;
  border-radius: 50%;
  background: rgba(255, 255, 255, .92);
  color: #176b44;
  box-shadow: 0 5px 15px rgba(28, 72, 43, .08);
  transition: transform .18s ease, border-color .18s ease, background .18s ease, color .18s ease;
}
.theme-mode-toggle:hover {
  border-color: #9bc9aa;
  background: #eef8f0;
  color: #087744;
  transform: translateY(-1px);
}

html[data-theme="dark"] {
  background: #020b0e;
  color-scheme: dark;
}
html[data-theme="dark"] body {
  background: #020b0e;
  color: #f2f7f5;
}
.app.premium-theme.dark-theme {
  --dark-bg: #020b0e;
  --dark-bg-soft: #061317;
  --dark-panel: rgba(5, 17, 21, .91);
  --dark-panel-solid: #07171b;
  --dark-panel-raised: #0a1c20;
  --dark-border: rgba(30, 222, 139, .23);
  --dark-border-strong: rgba(30, 240, 145, .46);
  --dark-green: #16ed8f;
  --dark-green-strong: #00c970;
  --dark-green-deep: #00683d;
  --dark-text: #f5f8f7;
  --dark-muted: #9aa9ad;
  --dark-faint: #6f8084;
  position: relative;
  isolation: isolate;
  overflow-x: clip;
  background:
    radial-gradient(ellipse 42% 24% at 98% -2%, rgba(0, 242, 136, .28), transparent 72%),
    radial-gradient(ellipse 34% 28% at 7% 92%, rgba(0, 164, 97, .19), transparent 75%),
    radial-gradient(circle at 64% 45%, rgba(0, 113, 76, .08), transparent 35%),
    linear-gradient(135deg, #020b0e 0%, #061116 49%, #020a0d 100%) !important;
  color: var(--dark-text);
}
.app.premium-theme.dark-theme::before,
.app.premium-theme.dark-theme::after {
  position: fixed;
  z-index: 0;
  content: "";
  pointer-events: none;
}
.app.premium-theme.dark-theme::before {
  top: -24vw;
  right: -11vw;
  width: min(72vw, 1120px);
  height: min(42vw, 650px);
