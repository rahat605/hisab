			alert(`Not enough cash in hand. Available: ${money(Math.max(0, cashInHand))}.`);
			return;
		}
		if (settlement.sourceType === "cash_contribution") {
			const refundableBalance = Math.max(0, roundMoney(-Math.min(0, memberMealBalance(toMember))));
			if (Number(settlement.amount) > refundableBalance + .009) {
				alert(`Balances changed. ${toMember.name} can now receive at most ${money(refundableBalance)}. Delete this plan and add a smaller settlement.`);
				return;
			}
		}
		if (settlement.sourceType === "direct") {
			const allowed = Math.max(0, roundMoney(Math.min(memberMealBalance(fromMember), Math.abs(Math.min(0, memberMealBalance(toMember))))));
