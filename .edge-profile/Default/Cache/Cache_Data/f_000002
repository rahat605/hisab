		if (!admin || !/^\d{4}-\d{2}-\d{2}$/.test(cashForm.date) || !Number.isFinite(Number(cashForm.amount)) || Number(cashForm.amount) <= 0 || !cashForm.paidBy) {
			alert("Enter a valid contribution date, member, and amount.");
			return;
		}
		try {
			const wasEditing = Boolean(cashForm.id);
			const previousContribution = wasEditing ? (db.contributions || []).find((contribution) => contribution.id === cashForm.id) : null;
			const nextAmount = Number(cashForm.amount);
			const affectedMemberIds = new Set([previousContribution?.paidBy, cashForm.paidBy].filter(Boolean));
			for (const memberId of affectedMemberIds) {
				const nextMemberContribution = roundMoney(memberCashContribution(memberId) - (previousContribution?.paidBy === memberId ? Number(previousContribution.amount || 0) : 0) + (cashForm.paidBy === memberId ? nextAmount : 0));
				const allocated = cashSettlementAllocatedBy(memberId);
				if (nextMemberContribution + .009 < allocated) {
					const memberName = db.users.find((member) => member.id === memberId)?.name || "This member";
					throw new Error(`${memberName} already has ${money(allocated)} assigned to settlement plans. Delete or complete those entries before reducing or moving this contribution.`);
				}
			}
			const nextCashContributionsTotal = roundMoney(cashContributionsTotal - Number(previousContribution?.amount || 0) + nextAmount);
			const committedCash = roundMoney(cashBazarSpent + completedCashSettlementTotal + pendingCashSettlementTotal);
			if (nextCashContributionsTotal + .009 < committedCash) {
				throw new Error(`${money(committedCash)} is already spent or reserved. The total cash contributions cannot be reduced below that amount.`);
			}
			const selectedMonth = cashForm.month || month;
			const mid = await monthIdFor(selectedMonth);
			const contribution = {
				month_id: mid,
				entry_date: cashForm.date,
				amount: Number(cashForm.amount),
				paid_by: cashForm.paidBy,
				note: cashForm.note
			};
			const { error } = cashForm.id ? await supabase.from("cash_contributions").update(contribution).eq("id", cashForm.id) : await supabase.from("cash_contributions").insert({
				...contribution,
				created_by: user.id
			});
			if (error) throw error;
			void loadNotices(false, user.id).catch((notificationError) => console.warn("Could not refresh cash notifications:", notificationError?.message));
			await loadCloudData(user.id, month);
			setCashForm((form) => ({
				...form,
				id: null,
				amount: "",
				note: "Cash contribution"
			}));
			setShowAddCash(false);
			setBazarSuccessToast(wasEditing ? "Cash contribution updated successfully" : "Cash contribution saved successfully");
			window.setTimeout(() => setBazarSuccessToast(""), 2600);
		} catch (e) {
			alert(`Could not ${cashForm.id ? "update" : "save"} cash contribution: ${e.message}`);
		}
	}
