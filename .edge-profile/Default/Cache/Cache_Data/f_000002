				supabase.from("bazar_entries").select("*").eq("month_id", monthRow.id).order("entry_date", { ascending: false }),
				supabase.from("cash_contributions").select("*").eq("month_id", monthRow.id).order("entry_date", { ascending: false }),
				supabase.from("member_settlements").select("*").eq("month_id", monthRow.id).order("settlement_date", { ascending: false }),
				supabase.from("app_settings").select("value").eq("key", `utility_paid_status_${label}`).maybeSingle(),
				activeProfile.role === "admin" ? supabase.from("profiles").select("id,last_login_at") : Promise.resolve({
					data: [],
					error: null
				})
			]);
			for (const r of [
				catsRes,
				payRes,
				bazRes,
				cashRes,
				utilityPaidResult
			]) if (r.error) throw r.error;
			if (settlementRes.error) {
				const migrationHint = isMissingSettlementTableError(settlementRes.error) ? "Run supabase/migrations/20261105_member_settlements.sql in Supabase." : settlementRes.error.message;
				setSettlementLoadError(migrationHint);
