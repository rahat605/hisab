	async function exportMemberLastMonthBill(member) {
		const reportWindow = window.open("", "_blank");
		const popupBlocked = !reportWindow;
		const reportDocument = reportWindow ? reportWindow.document : document.implementation.createHTMLDocument("Preparing monthly bill");
		if (reportWindow) {
			reportDocument.write("<!doctype html><title>Preparing monthly bill</title><p style='font:16px \"Hind Siliguri\",sans-serif;padding:32px'>Preparing monthly bill…</p>");
		}
		try {
			if (!supabaseConfigured) throw new Error("Supabase is not configured.");
			const previousMonthDate = new Date();
			previousMonthDate.setDate(1);
			previousMonthDate.setMonth(previousMonthDate.getMonth() - 1);
			const reportMonth = previousMonthDate.toLocaleDateString("en-US", {
				month: "long",
				year: "numeric"
			});
			const { data: monthRow, error: monthError } = await supabase.from("months").select("id").eq("label", reportMonth).maybeSingle();
			if (monthError) throw monthError;
			if (!monthRow) throw new Error(`No monthly data found for ${reportMonth}.`);
			const [categoriesResult, paymentsResult, bazarsResult, contributionsResult, settlementsResult, mealSettingResult, monthUtilitiesResult, sharedUtilitiesResult, utilityCountResult] = await Promise.all([
				supabase.from("expense_categories").select("name,amount,shared").eq("month_id", monthRow.id),
				supabase.from("rent_payments").select("user_id,amount,note,payment_type").eq("month_id", monthRow.id),
				supabase.from("bazar_entries").select("amount,paid_by,paid_from_cash").eq("month_id", monthRow.id),
				supabase.from("cash_contributions").select("amount,paid_by").eq("month_id", monthRow.id),
				supabase.from("member_settlements").select("amount,from_user_id,to_user_id,source_type,status").eq("month_id", monthRow.id),
				supabase.from("app_settings").select("value").eq("key", `meal_active_members_${reportMonth}`).maybeSingle(),
				supabase.from("app_settings").select("value").eq("key", `shared_utilities_list_${reportMonth}`).maybeSingle(),
				supabase.from("app_settings").select("value").eq("key", "shared_utilities_list").maybeSingle(),
				supabase.from("app_settings").select("value").eq("key", "utilities_current_users").maybeSingle()
			]);
			for (const result of [
				categoriesResult,
				paymentsResult,
				bazarsResult,
				contributionsResult,
				mealSettingResult,
				monthUtilitiesResult,
				sharedUtilitiesResult,
				utilityCountResult
			]) {
				if (result.error) throw result.error;
			}
			if (settlementsResult.error && !isMissingSettlementTableError(settlementsResult.error)) {
				throw settlementsResult.error;
			}
			const parseSetting = (setting, fallback) => {
				if (!setting?.value) return fallback;
				try {
					return JSON.parse(setting.value);
				} catch {
					throw new Error(`Invalid monthly settings for ${reportMonth}.`);
				}
			};
			const configuredUtilities = parseSetting(monthUtilitiesResult.data || sharedUtilitiesResult.data, null);
			const utilities = Array.isArray(configuredUtilities) ? configuredUtilities : (categoriesResult.data || []).filter((category) => String(category.name || "").toLowerCase() !== "bazar").map((category) => ({
				name: category.name,
				amount: category.amount,
				shared: category.shared
			}));
			const mealMemberIds = parseSetting(mealSettingResult.data, []);
			if (!Array.isArray(mealMemberIds)) throw new Error(`Invalid meal-member settings for ${reportMonth}.`);
			const utilityMemberCount = Number(utilityCountResult.data?.value || 4);
			if (!Number.isFinite(utilityMemberCount) || utilityMemberCount <= 0) throw new Error("Utility-sharing member count is invalid.");
			const sharedUtilitiesForReport = utilities.filter((utility) => utility.shared && !isFlatRentName(utility.name));
			const utilitiesShare = sharedUtilitiesForReport.reduce((sum, utility) => sum + Number(utility.amount || 0) / utilityMemberCount, 0);
			const bazars = bazarsResult.data || [];
			const contributions = contributionsResult.data || [];
			const reportSettlements = settlementsResult.error ? [] : (settlementsResult.data || []).filter((settlement) => settlement.status === "completed");
			const payments = paymentsResult.data || [];
			const rentPayments = payments.filter((payment) => payment.user_id === member.id && (payment.payment_type || (String(payment.note || "").toLowerCase().includes("rent") ? "rent" : "meal")) === "rent").reduce((sum, payment) => sum + Number(payment.amount || 0), 0);
			const mealPayments = payments.filter((payment) => payment.user_id === member.id && (payment.payment_type || (String(payment.note || "").toLowerCase().includes("rent") ? "rent" : "meal")) === "meal").reduce((sum, payment) => sum + Number(payment.amount || 0), 0);
			const mealCredits = bazars.filter((bazar) => !bazar.paid_from_cash && bazar.paid_by === member.id).reduce((sum, bazar) => sum + Number(bazar.amount || 0), 0) + contributions.filter((contribution) => contribution.paid_by === member.id).reduce((sum, contribution) => sum + Number(contribution.amount || 0), 0) + reportSettlements.filter((settlement) => settlement.source_type === "direct" && settlement.from_user_id === member.id).reduce((sum, settlement) => sum + Number(settlement.amount || 0), 0) - reportSettlements.filter((settlement) => settlement.to_user_id === member.id).reduce((sum, settlement) => sum + Number(settlement.amount || 0), 0);
			const mealCost = mealMemberIds.includes(member.id) ? Math.ceil(bazars.reduce((sum, bazar) => sum + Number(bazar.amount || 0), 0) / Math.max(1, mealMemberIds.length)) : 0;
			const totalMonthlyBill = Number(member.rent || 0) + utilitiesShare + mealCost;
			const mealPaid = mealPayments + mealCredits;
			const balanceDue = Math.ceil(totalMonthlyBill - rentPayments - mealPaid);
			const escapeHtml = (value) => String(value ?? "").replace(/[&<>"']/g, (character) => ({
				"&": "&amp;",
				"<": "&lt;",
				">": "&gt;",
				"\"": "&quot;",
				"'": "&#39;"
			})[character]);
			const utilityRows = sharedUtilitiesForReport.map((utility) => `<tr><td>${escapeHtml(utility.name)}</td><td>${money(utility.amount)}</td><td>${money(Number(utility.amount || 0) / utilityMemberCount)}</td></tr>`).join("");
			const generatedDate = new Date().toLocaleDateString();
			reportDocument.open();
			reportDocument.write(`<!doctype html>
