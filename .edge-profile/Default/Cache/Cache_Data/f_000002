				supabase.from("app_settings").select("value").eq("key", "bazar_needed_items").maybeSingle()
			]);
			if (pe) throw pe;
			if (mealSettingError) throw mealSettingError;
			if (utilityCountError) throw utilityCountError;
			if (sharedUtilityError) throw sharedUtilityError;
			if (monthUtilityError) throw monthUtilityError;
			if (bazarNeededError) throw bazarNeededError;
			const activeProfile = (profiles || []).find((p) => p.id === profileId && p.active);
			if (!activeProfile) throw new Error("Your profile is inactive or unavailable.");
