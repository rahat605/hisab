		let { data, error } = await supabase.from("months").select("id,label,current_count,current_members,is_current").eq("label", label).maybeSingle();
		if (error) throw error;
		if (!data && createIfMissing) {
			if (!session?.id || db.users.find((u) => u.id === session.id)?.role !== "admin") throw new Error("This month is not set up yet. Ask the admin to create/save its monthly setup first.");
			const { data: created, error: createError } = await supabase.from("months").insert({
				label,
				current_count: 0,
				current_members: [],
				is_current: false
			}).select("id,label,current_count,current_members,is_current").single();
			if (createError) throw createError;
			data = created;
			// Step 2: initialize a new month with the latest earlier month's utilities.
			// Monthly rows remain independent, so later edits do not rewrite past months.
			try {
				const { data: monthRows, error: monthRowsError } = await supabase.from("months").select("id,label");
				if (monthRowsError) throw monthRowsError;
				const monthIndex = (value) => {
					const parsed = new Date(`${value} 1`);
					return Number.isNaN(parsed.getTime()) ? -1 : parsed.getFullYear() * 12 + parsed.getMonth();
				};
				const targetIndex = monthIndex(label);
				const previousMonth = (monthRows || []).filter((row) => row.id !== data.id && monthIndex(row.label) >= 0 && monthIndex(row.label) < targetIndex).sort((a, b) => monthIndex(b.label) - monthIndex(a.label))[0];
				if (previousMonth) {
					const { data: previousUtilities, error: utilitiesError } = await supabase.from("expense_categories").select("name,amount,shared,created_by").eq("month_id", previousMonth.id);
					if (utilitiesError) throw utilitiesError;
					const copiedUtilities = (previousUtilities || []).filter((category) => String(category.name).toLowerCase() !== "bazar").map((category) => ({
						month_id: data.id,
						name: category.name,
						amount: Number(category.amount || 0),
						shared: !!category.shared,
						created_by: category.created_by || session.id
					}));
					if (copiedUtilities.length) {
						const { error: copyError } = await supabase.from("expense_categories").upsert(copiedUtilities, { onConflict: "month_id,name" });
						if (copyError) throw copyError;
					}
				}
			} catch (copyError) {
				console.warn("Could not copy previous month's utility defaults:", copyError);
			}
		}
		return data;
