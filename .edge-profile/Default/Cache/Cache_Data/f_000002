		if (!body && !file || body.length > 2e3 || !selectedInboxMemberId || !session?.id) return;
		setInboxBusy(true);
		setInboxError("");
		let uploadedPath = "";
		try {
			let attachment = {};
			if (file) {
				if (file.size > 10 * 1024 * 1024) {
					throw new Error("Choose a file smaller than 10 MB.");
				}
				const extension = file.name.split(".").pop()?.toLowerCase().replace(/[^a-z0-9]/g, "").slice(0, 10);
				uploadedPath = `${session.id}/${crypto.randomUUID()}${extension ? `.${extension}` : ""}`;
				const { error: uploadError } = await supabase.storage.from("inbox-attachments").upload(uploadedPath, file, {
					contentType: file.type || "application/octet-stream",
					upsert: false
				});
				if (uploadError) throw uploadError;
				attachment = {
					attachment_path: uploadedPath,
					attachment_name: file.name,
					attachment_type: file.type || "application/octet-stream",
					attachment_size: file.size
				};
			}
			const { error: sendError } = await supabase.from("direct_messages").insert({
				sender_id: session.id,
				recipient_id: selectedInboxMemberId,
				body: body || null,
				...attachment
			});
