			}
			if (Array.isArray(savedMealIds)) setMealActiveIds(savedMealIds);
			const savedUtilityCount = Number(utilityCountSetting?.value || 4);
			if (Number.isFinite(savedUtilityCount) && savedUtilityCount > 0) {
				setUtilityMemberCount(savedUtilityCount);
				setUtilityMemberCountInput(String(savedUtilityCount));
