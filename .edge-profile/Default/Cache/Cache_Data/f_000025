}
.contacts-directory .contact-category-card {
  padding: 22px;
  border-radius: 20px;
  border: 1px solid #dce6f5;
  background: linear-gradient(145deg, #ffffff 0%, #f8fbff 100%);
  box-shadow: 0 10px 28px rgba(31, 65, 115, 0.055);
  transition: box-shadow .2s ease, transform .2s ease;
}
.contacts-directory .contact-category-card:hover {
  box-shadow: 0 16px 34px rgba(31, 65, 115, 0.09);
  transform: translateY(-1px);
}
.contacts-directory .contact-category-heading {
  gap: 12px;
  margin-bottom: 18px;
}
.contacts-directory .contact-category-heading h3 {
  font-size: 18.5px;
  font-weight: 750;
  letter-spacing: -0.2px;
}
.contacts-directory .contact-category-heading small {
  padding: 6px 10px;
  border-radius: 999px;
  background: #f0f5fc;
  color: #64748b;
  font-size: 14px;
  font-weight: 650;
}
.contacts-directory .contact-category-icon {
  width: 38px;
  height: 38px;
  border-radius: 13px;
  box-shadow: inset 0 1px 0 rgba(255,255,255,.7);
}
.contacts-directory .contact-person-card {
  gap: 12px;
  padding: 12px;
  margin-top: 10px;
  border-radius: 14px;
  border-color: #e1eaf6;
  background: rgba(255,255,255,.88);
  box-shadow: 0 3px 10px rgba(28, 57, 98, .025);
  transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease;
}
.contacts-directory .contact-person-card:hover {
  border-color: #cbdaf0;
  box-shadow: 0 7px 18px rgba(28, 57, 98, .07);
  transform: translateY(-1px);
}
.contacts-directory .contact-person-avatar {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  background: #edf3fb;
  color: #647b9b;
}
.contacts-directory .contact-person-info b {
  font-size: 16px;
  font-weight: 700;
  letter-spacing: -0.1px;
}
.contacts-directory .contact-person-info a {
  font-size: 14.5px;
  line-height: 1.5;
}
.contacts-directory .contact-call-btn {
  padding: 9px 13px;
