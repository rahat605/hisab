.settlement-page .settlement-ledger-card.partially_paid {
  border-color: #e7cf93;
  background: linear-gradient(145deg, #fffdf7, #fff8e8);
}
.settlement-page .settlement-status.partially_paid {
  color: #8a5a08;
  background: #fff0bf;
}
.settlement-page .settlement-payment-summary {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 6px;
  margin-top: 7px;
}
.settlement-page .settlement-payment-summary > span,
.settlement-confirm-summary > span {
  min-width: 0;
  padding: 7px 8px;
  border: 1px solid #e3eae5;
  border-radius: 9px;
  background: rgba(255, 255, 255, .72);
}
.settlement-page .settlement-payment-summary small,
.settlement-page .settlement-payment-summary strong,
.settlement-confirm-summary small,
.settlement-confirm-summary strong {
  display: block;
}
.settlement-page .settlement-payment-summary small,
.settlement-confirm-summary small {
  color: #7b887f;
  font-size: 13px;
  font-weight: 700;
  line-height: 1.2;
  text-transform: uppercase;
  letter-spacing: .04em;
}
.settlement-page .settlement-payment-summary strong,
.settlement-confirm-summary strong {
  margin-top: 3px;
  color: #26372d;
  font-size: 15px;
  font-weight: 850;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
.settlement-page .settlement-payment-summary .is-paid strong {
  color: #087846;
}
.settlement-page .settlement-payment-summary .is-remaining strong {
  color: #a15a12;
}
.settlement-confirm-modal {
  width: min(520px, 100%) !important;
}
.settlement-confirm-summary {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 9px;
}
.settlement-confirm-summary > span:nth-child(2) strong {
  color: #087846;
}
.settlement-confirm-summary > span:nth-child(3) strong {
  color: #a15a12;
}
@media (max-width: 500px) {
  .settlement-page .settlement-payment-summary,
  .settlement-confirm-summary {
    gap: 5px;
  }
  .settlement-page .settlement-payment-summary > span,
  .settlement-confirm-summary > span {
    padding: 6px;
  }
  .settlement-page .settlement-payment-summary small,
  .settlement-confirm-summary small {
    font-size: 13px;
  }
  .settlement-page .settlement-payment-summary strong,
  .settlement-confirm-summary strong {
    font-size: 15px;
  }
}

/* Project-wide typography and responsive scaling guardrails. */
html {
  min-width: 320px;
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
}
body {
  min-width: 320px;
  overflow-x: hidden;
}
.app,
.main,
.main > *,
.panel,
.stat,
.grid-two,
.content-grid,
.stats,
.table-wrap,
.panel-head,
.welcome,
.header-actions,
.form-panel,
.person,
.row-actions {
  min-width: 0;
}
.app {
  overflow-x: clip;
}
button,
input,
select,
textarea {
  max-width: 100%;
  line-height: 1.35;
}
textarea {
  font: inherit;
}
h1,
h2,
h3,
h4,
p,
small,
label,
td,
th {
  overflow-wrap: break-word;
}
.panel-head h2,
.panel-head h3,
.welcome h1,
.app-page-heading h2 {
  line-height: 1.2;
}
.table-wrap {
  width: 100%;
  max-width: 100%;
  overflow-x: auto;
  overscroll-behavior-inline: contain;
  -webkit-overflow-scrolling: touch;
}
.modal-backdrop > *,
.modal-backdrop .modal {
  min-width: 0;
  max-width: 100%;
}

@media (max-width: 700px) {
  .main {
    width: 100%;
    padding-right: 12px;
    padding-left: 12px;
  }
  .main > header,
  .main > header > *,
  .app-page-heading,
  .welcome > *,
  .panel-head > * {
    min-width: 0;
  }
  .main > header {
    width: 100%;
  }
  .main > header .app-page-heading {
    flex: 1 1 auto;
  }
  .main > header .header-actions {
    flex: 0 0 auto;
  }
  .main > header .header-actions select {
    width: auto;
    max-width: min(36vw, 150px);
  }
  input,
  select,
  textarea {
    font-size: 16px !important;
  }
  .primary,
  .secondary,
  button:not(.icon-btn) {
    font-size: 15px;
  }
  th {
    font-size: 14px;
  }
  td {
    font-size: 15px;
  }
  .modal-backdrop {
    padding: 12px !important;
  }
  .modal-backdrop > *,
  .modal-backdrop .modal {
    width: min(100%, 680px);
    max-height: calc(100dvh - 24px);
  }
  footer {
    flex-wrap: wrap;
  }
}

@media (max-width: 420px) {
  :root .login-shell .login-card {
    padding-right: 22px !important;
    padding-left: 22px !important;
  }
  .stats {
    grid-template-columns: minmax(0, 1fr);
  }
  .welcome h1 {
    font-size: 22px;
  }
  .panel,
  .stat {
    padding-right: 13px;
    padding-left: 13px;
  }
  .header-actions {
    gap: 6px;
  }
  footer {
    align-items: flex-start;
    flex-direction: column;
  }
}
