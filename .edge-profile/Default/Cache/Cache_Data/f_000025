/* Premium visual refinement layer: CSS only, no behavior changes */
:root {
  --premium-ease: cubic-bezier(.2,.7,.2,1);
}
body { text-rendering: optimizeLegibility; }
.app-shell, .main-content, .page-content { min-width: 0; }
.card, .panel, .section-card, .contact-category-card, .modal-content {
  transition: box-shadow .22s var(--premium-ease), border-color .22s var(--premium-ease), transform .22s var(--premium-ease);
}
.card, .panel, .section-card {
  border-radius: 18px;
  box-shadow: 0 8px 24px rgba(35, 68, 112, .045);
}
button, .btn, input, select, textarea {
  transition: background-color .18s var(--premium-ease), border-color .18s var(--premium-ease), box-shadow .18s var(--premium-ease), transform .18s var(--premium-ease);
}
button:focus-visible, .btn:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible {
  outline: 3px solid rgba(91, 105, 245, .24); outline-offset: 2px;
}
button:not(:disabled):active, .btn:not(:disabled):active { transform: translateY(1px) scale(.99); }
.table-wrap, .table-container { border-radius: 14px; overflow: hidden; }
table thead th { letter-spacing: .045em; text-transform: uppercase; font-size: 14px; }
table tbody tr { transition: background-color .16s ease; }
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { transition-duration: .01ms !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; }
}

