/* Reference-matched login layout */
.login-wrap {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 34px 24px 20px;
  background:
    radial-gradient(circle at 0 0, rgba(126, 143, 255, .20), transparent 25%),
    radial-gradient(circle at 100% 100%, rgba(111, 163, 255, .18), transparent 28%),
    linear-gradient(135deg,#edf3ff,#f8fbff 52%,#eaf2ff);
}
.login-shell {
  width: min(100%, 960px);
  min-height: 560px;
  display: grid;
  grid-template-columns: 1fr 1.12fr;
  overflow: hidden;
  border: 1px solid #dbe5f7;
  border-radius: 28px;
  background: #fff;
  box-shadow: 0 24px 70px rgba(48, 78, 135, .15);
}
.login-brand-panel {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding: 48px 38px;
  color: white;
  background: linear-gradient(145deg,#4268f5,#2447d7 62%,#243bb4);
}
.login-brand-panel:before,
.login-brand-panel:after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: rgba(255,255,255,.11);
}
.login-brand-panel:before { width: 250px;height:250px;right:-130px;bottom:-120px; }
.login-brand-panel:after { width:190px;height:190px;left:-115px;top:-120px; }
.login-brand-panel h2 { position:relative;z-index:1;margin:28px 0 8px;font-size:33.5px;letter-spacing:-.8px;font-weight:800;color:#fff; }
.login-brand-panel p { position:relative;z-index:1;margin:0;color:#e4ebff;font-size:18.5px; }
.login-brand-panel p:after { content:"";display:block;width:62px;height:4px;margin-top:20px;border-radius:5px;background:#fff; }
.login-brand-art { position:relative;z-index:1;display:flex;align-items:center;justify-content:center;min-height:175px;margin:12px 0 16px;font-size:84px;filter:drop-shadow(0 12px 9px rgba(10,25,80,.18)); }
.login-brand-panel ul { position:relative;z-index:1;display:grid;gap:15px;margin:0;padding:0;list-style:none;font-size:16px;font-weight:600; }
.login-brand-panel li:before { content:"✓";display:inline-grid;place-items:center;width:28px;height:28px;margin-right:12px;border-radius:9px;background:#ffffff25;color:white;font-weight:800; }
.login-shell .login-card { width:auto;max-width:none;min-height:560px;justify-content:center;padding:42px 48px;border:0;border-radius:0;box-shadow:none;background:linear-gradient(160deg,#fff,#fbfcff); }
.login-shell .login-card .brand-mark { margin-bottom:2px; }
.login-shell .login-card h1 { margin:0;font-size:29px; }
.login-shell .login-card p { margin:0 0 12px; }
.login-shell .login-card label { margin-top:7px; }
.login-shell .login-card input { min-height:52px; }
.login-shell .login-card .primary { margin-top:8px; }
.login-footer-credit { margin-top:22px; }
@media(max-width:760px) {
  .login-wrap { padding:18px 14px 14px; }
  .login-shell { display:block;width:min(100%,430px);min-height:0;border-radius:24px; }
  .login-brand-panel { display:none; }
  .login-shell .login-card { min-height:0;padding:28px 22px;border-radius:24px; }
  .login-shell .login-card h1 { font-size:26px; }
  .login-footer-credit { margin-top:16px; }
}

