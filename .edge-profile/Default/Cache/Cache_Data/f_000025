/* Member accounts become readable cards on phones instead of a clipped table. */
@media (max-width: 700px) {
  .member-page-grid,
  .member-accounts-panel {
    width: 100%;
    min-width: 0;
  }

  .member-accounts-panel {
    padding: 14px !important;
  }

  .member-accounts-heading {
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
  }

  .member-accounts-heading > .primary {
    width: 100%;
    min-height: 42px;
  }

  .member-accounts-panel .table-wrap {
    width: 100%;
    min-width: 0;
    overflow: visible !important;
    border: 0;
    border-radius: 0;
    background: transparent !important;
  }

  .member-accounts-panel table {
    display: block;
    width: 100%;
    min-width: 0;
    border-collapse: separate;
    white-space: normal;
  }

  .member-accounts-panel thead {
    display: none;
  }

  .member-accounts-panel tbody {
    display: grid;
    width: 100%;
    gap: 12px;
  }

  .member-accounts-panel tbody tr {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 14px;
    width: 100%;
    min-width: 0;
    padding: 14px;
    border: 1px solid #dfe8e2;
    border-radius: 16px;
    background: linear-gradient(145deg, #fff, #f7fbf8);
    box-shadow: 0 5px 16px rgba(22, 74, 49, .07);
  }

  .member-accounts-panel tbody td {
    display: flex;
    min-width: 0;
    padding: 9px 0;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    border: 0;
    border-bottom: 1px solid #e9efeb;
    overflow-wrap: anywhere;
    white-space: normal;
    font-size: 14px;
    line-height: 1.4;
  }

  .member-accounts-panel tbody td::before {
    margin-bottom: 4px;
    color: #7b8d83;
    font-size: 14px;
    font-weight: 750;
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  .member-accounts-panel tbody td:first-child {
    grid-column: 1 / -1;
    padding-top: 0;
    color: #173c2c;
    font-size: 17.5px;
  }

  .member-accounts-panel tbody td:first-child::before {
    content: none;
  }

  .member-accounts-panel tbody td:nth-child(2)::before { content: "User ID"; }
  .member-accounts-panel tbody td:nth-child(3)::before { content: "Rent"; }
  .member-accounts-panel tbody td:nth-child(4)::before { content: "Meal"; }
  .member-accounts-panel tbody td:nth-child(5)::before { content: "Status"; }
  .member-accounts-panel tbody td:nth-child(6)::before { content: "Last active"; }
  .member-accounts-panel tbody td:nth-child(7)::before { content: "Report"; }
  .member-accounts-panel tbody td:nth-child(8)::before { content: "Actions"; }

  .member-accounts-panel tbody td:nth-child(6) {
    grid-column: 1 / -1;
  }

  .member-accounts-panel tbody td:nth-child(7),
  .member-accounts-panel tbody td:nth-child(8) {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .member-accounts-panel .meal-table-toggle {
    justify-content: flex-start;
  }

  .member-accounts-panel .actions {
    flex-wrap: wrap;
  }

  .member-accounts-panel .meal-table-footer {
    align-items: stretch;
    gap: 10px;
    padding: 16px 0 0;
  }

  .member-accounts-panel .meal-table-footer .btn {
    width: 100%;
    min-height: 42px;
    margin-left: 0;
  }
}

