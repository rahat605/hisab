/* Refined modern accent palette: restrained color, clear contrast, no neon overload */
:root {
  --accent: #4f63f5;
  --accent-hover: #3f51df;
  --accent-soft: #eef2ff;
  --accent-border: #cdd5ff;
  --success: #159a72;
  --success-soft: #e8f8f1;
  --warning: #c47b19;
  --warning-soft: #fff5e5;
  --danger: #d94a57;
  --danger-hover: #bf3544;
  --danger-soft: #fff0f1;
}

/* Primary actions */
button.primary,
button.full.primary,
.primary,
button[type="submit"],
form button[type="submit"] {
  background: linear-gradient(135deg, #586cf6 0%, #4658e8 100%);
  color: #fff;
  border: 1px solid transparent;
  box-shadow: 0 3px 9px rgba(79, 99, 245, .16);
  transition: background .18s ease, box-shadow .18s ease, transform .18s ease;
}
button.primary:hover,
button.full.primary:hover,
.primary:hover,
button[type="submit"]:hover,
form button[type="submit"]:hover {
  background: linear-gradient(135deg, #4c60ee 0%, #394bd4 100%);
  box-shadow: 0 5px 13px rgba(79, 99, 245, .23);
  transform: translateY(-1px);
}

/* Secondary and quiet actions */
button.secondary,
button.ghost,
button.icon-btn {
  transition: color .18s ease, background .18s ease, border-color .18s ease;
}
button.secondary {
  color: #4758d9;
  background: #f0f3ff;
  border: 1px solid #dce3ff;
}
button.secondary:hover {
  color: #3444c4;
  background: #e5eaff;
  border-color: #c7d1ff;
}

/* Destructive actions should be obvious but not shouty */
button.danger,
button.delete,
.action-delete {
  color: #c93e4c;
  background: #fff1f2;
  border: 1px solid #ffd7dc;
}
button.danger:hover,
button.delete:hover,
.action-delete:hover {
  color: #fff;
  background: #cf4351;
  border-color: #cf4351;
}

/* Form focus state */
input:focus,
select:focus,
textarea:focus {
  border-color: #8b9aff;
  box-shadow: 0 0 0 3px rgba(79, 99, 245, .12);
  outline: none;
}

/* Status badges and small highlights */
.badge-success,
.status-active,
.success-text {
  color: #087b59;
}
.badge-warning,
.status-pending {
  color: #98600e;
}
.badge-danger,
.status-inactive {
  color: #bd3442;
}

/* Keep links vivid enough to read without competing with primary buttons */
a {
  text-underline-offset: 3px;
}


/* Keep the six overview cards in one desktop row. */
.stats {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 15px;
  align-items: stretch;
}
.stats > .stat {
  min-width: 0;
